function Get-LBCategoryKeys { return @($script:Cat.Keys) }
function Get-LBCategoryTitle {
    param([string]$Category, $Config)
    $pair = $script:Cat[$Category]
    if (-not $pair) { return $Category }
    switch (Get-LogBokLang -Config $Config) { 'en' { $pair[0] } 'fa' { $pair[1] } default { "$($pair[1]) / $($pair[0])" } }
}

function Get-LogBokLang { param($Config)
    if ($Config -and $Config.Language) { return $Config.Language } else { return 'both' }
}

# متن محلی‌شده را برمی‌گرداند | returns localized text
function T {
    param([Parameter(Mandatory)][string]$Key, $Config, [Alias('Args')][object[]]$Fmt)
    $pair = $script:L[$Key]
    if (-not $pair) { return $Key }
    $en = $pair[0]; $fa = $pair[1]
    if ($Fmt) { $en = ($en -f $Fmt); $fa = ($fa -f $Fmt) }
    switch (Get-LogBokLang -Config $Config) {
        'en'   { return $en }
        'fa'   { return $fa }
        default { return "$en  |  $fa" }   # both
    }
}

Export-ModuleMember -Function T,Get-LogBokLang,Get-LBCategoryKeys,Get-LBCategoryTitle
