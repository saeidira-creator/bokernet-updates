# ==========================================================================
#  LogBok.Brand.psm1 - the LogBok application icon and the ONE desktop shortcut
#  The icon is embedded here so every server receives it with a normal code update.
#  Repair-LBDesktopShortcut (run by the watchdog on LogBok servers):
#    - writes LogBok.ico into the install folder (correct proportions, 16-256 px)
#    - removes old/duplicate LogBok shortcuts from the desktops
#    - keeps exactly one "LogBok Console" shortcut on the public desktop, with the icon
#  Dashboard / Activation stay in the Start Menu (LogBok folder) only.
# ==========================================================================
$script:LBIcoB64 = ''

function Repair-LBDesktopShortcut {
    param([Parameter(Mandatory)][string]$InstallDir, $Config)
    $changed = $false
    $ico = Join-Path $InstallDir 'LogBok-app.ico'   # new name so Windows does not reuse a cached blank icon
    $bytes = [Convert]::FromBase64String($script:LBIcoB64)
    $want = [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($bytes))
    $have = ''; if (Test-Path -LiteralPath $ico) { try { $have = [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash([IO.File]::ReadAllBytes($ico))) } catch { } }
    if ($have -ne $want) { [IO.File]::WriteAllBytes($ico, $bytes); $changed = $true }

    $port = 8686; try { if ($Config.Web.Port) { $port = [int]$Config.Web.Port } } catch { }
    $url = 'http://localhost:{0}/' -f $port
    $pub = 'C:\Users\Public\Desktop'
    $target = Join-Path $pub 'LogBok Console.url'
    $text = "[InternetShortcut]`r`nURL=$url`r`nIconFile=$ico`r`nIconIndex=0`r`n"

    # the shortcuts LogBok setups created (any version) on any desktop, except the one we keep
    $desks = @($pub) + @(Get-ChildItem 'C:\Users' -Directory -ErrorAction SilentlyContinue | ForEach-Object { Join-Path $_.FullName 'Desktop' } | Where-Object { Test-Path $_ })
    foreach ($d in ($desks | Select-Object -Unique)) {
        foreach ($f in @(Get-ChildItem -LiteralPath $d -File -ErrorAction SilentlyContinue | Where-Object { @('LogBok Console.lnk','LogBok Dashboard.lnk','LogBok Activation.lnk','LogBok.lnk','LogBok Console.url','LogBok.url') -contains $_.Name })) {
            if ($f.FullName -ieq $target) { continue }
            try { Remove-Item -LiteralPath $f.FullName -Force -ErrorAction Stop; $changed = $true } catch { }
        }
    }
    $cur = ''; if (Test-Path -LiteralPath $target) { try { $cur = [IO.File]::ReadAllText($target) } catch { } }
    if ($cur -ne $text) { try { [IO.File]::WriteAllText($target, $text, [Text.Encoding]::ASCII); $changed = $true } catch { } }
    if ($changed) { try { & ie4uinit.exe -show 2>$null } catch { } }   # refresh the icon cache
    return $changed
}

Export-ModuleMember -Function Repair-LBDesktopShortcut
