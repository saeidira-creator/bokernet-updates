# ==========================================================================
#  LogBok.AgentPkg.psm1 — ساختِ بستهٔ ایجنت برای نصبِ دستی و نصبِ از راه دور
#  Agent packages for manual install (Windows ZIP, Linux shell script) and
#  remote push install, plus a per-agent status store (state\agents\*.json).
#
#  ویندوز: ZIP شاملِ فایل‌های ایجنت + Install-LogBokAgent.cmd (دوبار کلیک، خودش
#          دسترسیِ مدیر می‌گیرد). ایجنت: حسابرسی/لاگ‌ها را روشن می‌کند، واچ‌داگ و
#          سپرِ ورود را نصب می‌کند و فقط به همین سرور اجازهٔ خواندنِ لاگ می‌دهد.
#  لینوکس: اسکریپتِ sh که rsyslog/syslog-ng را برای فرستادنِ لاگ‌های auth و
#          هشدارها به همین سرور (UDP 514) تنظیم می‌کند.
#  همه‌چیز سازوکارِ مستندِ سیستم‌عامل است؛ بدونِ پنهان‌سازی، قابلِ حذفِ کامل.
# ==========================================================================
$script:Inv = [Globalization.CultureInfo]::InvariantCulture
$script:AgentVersion = '1.7.7'
function Get-LBAgentVersion { return [string]$script:AgentVersion }

# فایل‌هایی که ایجنتِ ویندوز لازم دارد (همان فهرستِ LogBok.Deploy) | agent payload
$script:AgentPayload = @(
    'config.psd1','policies.psd1','LogBok.Core.psm1','LogBok.Agent.psm1','LogBok.Jobs.psm1',
    'LogBok.License.psm1','LogBok.Lang.psm1','LogBok.Firewall.psm1','LogBok.AntiRansomware.psm1',
    'LogBok.Behavior.psm1','LogBok.Policy.psm1','LogBok.Scanner.psm1','LogBok.Identity.psm1',
    'LogBok.Update.psm1','LogBok.Threat.psm1','LogBok.Traffic.psm1','LogBok.FwGovernance.psm1',
    'LogBok.FIM.psm1','LogBok.Guard.psm1','LogBok.Connect.psm1','LogBok.Sessions.psm1','Run-Watchdog.ps1','Run-Guard.ps1','Run-Connect.ps1','logbok-logo.svg'
)

# کلیدِ امضای رویدادهای ایجنت (یک‌بار ساخته می‌شود) | agent signing key
# --- اطلاعاتِ این سرور به‌عنوانِ گیرنده | this server as the collector ------------
function Get-LBCollectorInfo {
    param($Config)
    $ips = @()
    try {
        foreach ($ni in [Net.NetworkInformation.NetworkInterface]::GetAllNetworkInterfaces()) {
            if ($ni.OperationalStatus -ne 'Up' -or $ni.NetworkInterfaceType -eq 'Loopback') { continue }
            foreach ($ua in $ni.GetIPProperties().UnicastAddresses) {
                if ($ua.Address.AddressFamily -eq 'InterNetwork' -and -not $ua.Address.ToString().StartsWith('169.254.')) { $ips += $ua.Address.ToString() }
            }
        }
    } catch { }
    $ips = @($ips | Select-Object -Unique)
    $hostName = $env:COMPUTERNAME; if (-not $hostName) { $hostName = ([Net.Dns]::GetHostName() -split '\.')[0] }
    $domain = ''; $fqdn = $hostName; $account = ''
    try {
        $cs = Get-CimInstance Win32_ComputerSystem -ErrorAction Stop
        if ($cs.PartOfDomain) {
            $domain = [string]$cs.Domain; $fqdn = "$hostName.$domain"
            $nb = $env:USERDOMAIN
            if (-not $nb -or $nb -eq $hostName) { $nb = ($domain -split '\.')[0] }
            $account = "$nb\$hostName`$"
        }
    } catch { }
    # پیش‌فرض: نامِ خودِ سرور (اگر IP عوض شود ایجنت‌ها با DNS دوباره پیدایش می‌کنند)؛ قابلِ تغییر در تنظیمات (Agent.Collector)
    # default: the server's own name (agents re-resolve it if the IP changes); overridable via Agent.Collector
    $override = ''
    try { if (-not $Config) { $Config = Get-LogBokConfig }; if ($Config.Agent -and $Config.Agent.Collector) { $override = [string]$Config.Agent.Collector } } catch { }
    $default = if ($override) { $override } elseif ($domain) { $fqdn } else { $hostName }
    $names = @(@($override, $fqdn, $hostName) | Where-Object { $_ -and $_ -notmatch '^\d+\.\d+\.\d+\.\d+$' } | Select-Object -Unique)
    return [ordered]@{ Host = $hostName; Fqdn = $fqdn; Domain = $domain; Ips = $ips; Names = $names; Account = $account; Default = $default; Override = $override }
}

function Get-LBSyslogPort { param($Config) $p = 514; try { if ($Config -and $Config.Syslog -and $Config.Syslog.Port) { $p = [int]$Config.Syslog.Port } } catch { }; return $p }

function Test-LBAgentAddress { param([string]$s) return ($s -match '^[A-Za-z0-9_.\-:]{1,255}$') }

# --- اسکریپتِ نصبِ ویندوز | Windows installer script ------------------------------
$script:WinInstaller = @'
# ==========================================================================
#  Install-LogBokAgent.ps1 — LogBok agent (generated by the LogBok server)
#  Server: __COLLECTOR__   Version: __VERSION__   Package: __STAMP__   Built: __BUILT__
#  Install:   Install-LogBokAgent.cmd   (asks for admin rights itself)
#  Uninstall: Uninstall-LogBokAgent.cmd (needs this computer's uninstall code from the console)
# ==========================================================================
param([switch]$Unattended, [switch]$Uninstall, [string]$Code)
$me = [Security.Principal.WindowsIdentity]::GetCurrent()
$psExe = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
if (-not (New-Object Security.Principal.WindowsPrincipal($me)).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    if ($Unattended) { throw 'administrator rights required' }
    $a = "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`""
    if ($Uninstall) { $a += ' -Uninstall' }
    Start-Process -FilePath $psExe -Verb RunAs -ArgumentList $a -WorkingDirectory (Join-Path $env:SystemRoot 'System32')
    return
}
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
Set-Location (Join-Path $env:SystemRoot 'System32')     # never run anything from the download folder
$Collector        = '__COLLECTOR__'
$CollectorIps     = @(__COLLECTOR_IPS__)
$CollectorNames   = @(__COLLECTOR_NAMES__)
$PackageStamp     = '__STAMP__'
$EnrollToken      = '__ENROLL_TOKEN__'
$IngestPort       = __INGEST_PORT__
$src = Split-Path -Parent $MyInvocation.MyCommand.Path
$payload = Join-Path $src 'files'
$dst = Join-Path $env:ProgramData 'Agent'   # زیرِ ProgramData؛ پیش‌فرض از دیدِ کاربر پنهان ولی برای ادمین قابلِ مشاهده و محافظت‌شده | under ProgramData: hidden from the user by default, discoverable and ACL-protected for admins
$script:lines = New-Object System.Collections.ArrayList
function Say([string]$m, [string]$c = 'Gray') { [void]$script:lines.Add($m); if (-not $Unattended) { Write-Host $m -ForegroundColor $c } }
$ok = $true
if (-not $Unattended) { Write-Host "`n==== LogBok agent ====`n" -ForegroundColor White }
try {
    if ($Uninstall) {
        # ---- uninstall: only with this computer's uninstall code (tamper protection) ----
        if (Test-Path (Join-Path $dst 'LogBok.Agent.psm1')) {
            Import-Module (Join-Path $dst 'LogBok.Agent.psm1') -Force -DisableNameChecking
            $want = Get-LogBokUninstallCode -InstallDir $dst
            if ($want) {
                if (-not $Code -and -not $Unattended) { $Code = Read-Host 'Uninstall code for this computer (LogBok console > Agents)' }
                if ((([string]$Code) -replace '[^0-9A-Fa-f]', '').ToUpperInvariant() -ne ($want -replace '-', '')) { throw 'wrong uninstall code - the agent was NOT removed (this attempt is reported to the LogBok server)' }
                try { $ai = Get-LogBokAgentInfo -InstallDir $dst; [void](Send-LogBokSigned -InstallDir $dst -Info $ai -Path '/bye' -Object @{ by = $me.Name }) } catch { }
            }
            Uninstall-LogBokAgent -InstallDir $dst
        }
        try { Remove-NetFirewallRule -DisplayName 'LogBok-Agent-Collector' -ErrorAction SilentlyContinue } catch { }
        try { Remove-MpPreference -ExclusionPath $dst -ErrorAction SilentlyContinue } catch { }
        Say 'LogBok agent removed.' 'Green'
    } else {
        if (Test-Path 'C:\Scripts\LogBok\engine.flag') { throw 'This computer runs the LogBok server itself; the agent is not needed here.' }
        # 0) integrity: every file must match the package manifest, and all scripts must carry the
        #    same Authenticode signature as this installer (a modified package is refused)
        $man = Get-Content (Join-Path $src 'manifest.json') -Raw -Encoding UTF8 | ConvertFrom-Json
        $sha = [Security.Cryptography.SHA256]::Create()
        foreach ($p in $man.files.PSObject.Properties) {
            $fp = Join-Path $src $p.Name
            if (-not (Test-Path -LiteralPath $fp)) { throw "package incomplete: $($p.Name) is missing" }
            $h = -join ($sha.ComputeHash([IO.File]::ReadAllBytes($fp)) | ForEach-Object { $_.ToString('x2') })
            if ($h -ne [string]$p.Value) { throw "package was modified: $($p.Name) - download it again from the LogBok console" }
        }
        $extra = @(Get-ChildItem -Path $src -Recurse -File | Where-Object { $_.Name -ne 'manifest.json' } | ForEach-Object { $_.FullName.Substring($src.Length + 1) -replace '\\', '/' } | Where-Object { -not $man.files.PSObject.Properties[$_] })
        if ($extra.Count) { throw ("unexpected files in the package: {0}" -f ($extra -join ', ')) }
        $mine = Get-AuthenticodeSignature -FilePath $PSCommandPath
        if ($mine.SignerCertificate) {
            if ($mine.Status -eq 'HashMismatch') { throw 'the installer was modified after signing' }
            foreach ($f in (Get-ChildItem -Path $src -Recurse -Include *.ps1, *.psm1 -File)) {
                $sg = Get-AuthenticodeSignature -FilePath $f.FullName
                if (-not $sg.SignerCertificate -or $sg.Status -eq 'HashMismatch' -or $sg.SignerCertificate.Thumbprint -ne $mine.SignerCertificate.Thumbprint) { throw "signature check failed: $($f.Name)" }
            }
            $sig = $mine.SignerCertificate.Subject
        } else { $sig = 'unsigned' }
        Say ("[0/5] package verified ({0} files, {1})" -f @($man.files.PSObject.Properties).Count, $sig) 'Green'
        # 1) files (folder locked: SYSTEM and Administrators only may change it)
        if (-not (Test-Path $dst)) { New-Item -ItemType Directory -Path $dst -Force | Out-Null }
        foreach ($d in 'state','logs','reports') { $p = Join-Path $dst $d; if (-not (Test-Path $p)) { New-Item -ItemType Directory -Path $p -Force | Out-Null } }
        $n = 0
        foreach ($f in (Get-ChildItem -Path $payload -File)) { Copy-Item -LiteralPath $f.FullName -Destination (Join-Path $dst $f.Name) -Force; $n++ }
        Get-ChildItem -Path $dst -File -ErrorAction SilentlyContinue | Unblock-File -ErrorAction SilentlyContinue
        Say ("[1/5] files copied: {0} -> {1}" -f $n, $dst) 'Green'
        # نصبِ قدیمی در C:\Scripts\LogBok با همان هویت منتقل و پاک می‌شود | an old install in C:\Scripts\LogBok is moved (same identity) and removed
        try {
            Import-Module (Join-Path $dst 'LogBok.Agent.psm1') -Force -DisableNameChecking
            $mv = Move-LogBokAgentLegacy -Legacy 'C:\Scripts\LogBok' -NewDir $dst
            if ([string]$mv -like 'moved*') { Say ("[1/5] old install in C:\Scripts\LogBok {0}" -f $mv) 'Green' }
        } catch { Say ("[1/5] old install in C:\Scripts\LogBok could not be moved: {0}" -f $_.Exception.Message) 'Yellow' }
        # 2) agent (audit policy, logs, watchdog, login guard, self-protection) - no inbound ports are opened
        Import-Module (Join-Path $dst 'LogBok.Agent.psm1') -Force -DisableNameChecking
        Install-LogBokAgent -InstallDir $dst
        try { Remove-NetFirewallRule -DisplayName 'LogBok-Agent-Collector' -ErrorAction SilentlyContinue } catch { }
        Say '[2/5] agent installed (audit, event logs, watchdog, login guard); no inbound port opened' 'Green'
        # 3) Defender exclusion for the locked agent folder only (avoids scanning its own scripts)
        try { Add-MpPreference -ExclusionPath $dst -ErrorAction Stop } catch { }
        Say '[3/5] Microsoft Defender exclusion for the agent folder' 'Green'
        # 4) identity: a random secret made on THIS computer, protected with DPAPI; the package
        #    only carries a time-limited enrollment token which is deleted after enrollment
        $live = @()
        foreach ($nm in $CollectorNames) { try { $live += @([Net.Dns]::GetHostAddresses($nm) | Where-Object { $_.AddressFamily -eq 'InterNetwork' } | ForEach-Object { $_.IPAddressToString }) } catch { } }
        if ($live.Count) { $CollectorIps = @($live | Select-Object -Unique) }
        $prev = Get-LogBokAgentInfo -InstallDir $dst
        $keep = $null; if ($prev -and $prev.SecretEnc -and (Get-LogBokAgentSecret $prev)) { $keep = $prev }
        $sec = if ($keep) { @{ Enc = [string]$keep.SecretEnc } } else { New-LogBokAgentSecret }
        # the same server as before? (same address set) - otherwise the agent must enroll again with the new package's token
        $sameServer = $false
        if ($keep) { $pn = @(@($keep.CollectorNames) + $keep.Collector | Where-Object { $_ } | Sort-Object -Unique); $nn = @(@($CollectorNames) + $Collector | Where-Object { $_ } | Sort-Object -Unique); $sameServer = (($pn -join ',') -eq ($nn -join ',')) }
        $agentId = if ($keep -and $keep.AgentId) { [string]$keep.AgentId } else { [guid]::NewGuid().ToString() }
        $info = [pscustomobject][ordered]@{ Collector = $Collector; CollectorNames = $CollectorNames; CollectorIps = $CollectorIps; Version = '__VERSION__'; PackageStamp = $PackageStamp
                    IngestPort = $IngestPort; SecretEnc = $sec.Enc; AgentId = $agentId; Enrolled = [bool]($keep -and $keep.Enrolled -and $sameServer); EnrollToken = $EnrollToken
                    EnrollTokenEnc = (Protect-LogBokEnrollToken $EnrollToken); InstalledAt = (Get-Date).ToString('o'); Computer = $env:COMPUTERNAME }
        if ($info.Enrolled) { $info.PSObject.Properties.Remove('EnrollToken') }
        # package fingerprint (for safe self-update) and the signer the agent will trust for updates
        try { Set-LogBokInfoField $info 'PayloadHash' (Get-LogBokPayloadHash $man) } catch { }
        if ($mine.SignerCertificate) { Set-LogBokInfoField $info 'SignerThumbprint' ([string]$mine.SignerCertificate.Thumbprint) }
        Save-LogBokAgentInfo -InstallDir $dst -Info $info
        Say '[4/5] agent identity created (secret kept on this computer, DPAPI)' 'Green'
        # 5) enroll + first events now, so the computer shows up in the console right away
        $fw = $null; try { $fw = Invoke-LogBokForward -InstallDir $dst -FirstMinutes 120 } catch { }
        if ($fw -and $fw.Ok) { Say ("[5/5] connected to the LogBok server ({0} events sent) - this computer now appears in the console" -f $fw.Sent) 'Green' }
        else { Say ("[5/5] the LogBok server is not reachable yet ({0}); the agent keeps retrying every 2 minutes" -f $(if ($fw) { $fw.Error } else { 'no response' })) 'Yellow' }
        try {
            if (-not [Diagnostics.EventLog]::SourceExists('LogBok')) { New-EventLog -LogName Application -Source 'LogBok' }
            Write-EventLog -LogName Application -Source 'LogBok' -EventId 9010 -EntryType Information -Message ("LogBok agent {0} installed on {1}; server {2}" -f '__VERSION__', $env:COMPUTERNAME, $Collector)
        } catch { }
        Say "`nDone. The LogBok server ($Collector) now monitors this computer." 'Cyan'
    }
} catch {
    $ok = $false
    Say ("ERROR: " + $_.Exception.Message) 'Red'
    try { if (-not [Diagnostics.EventLog]::SourceExists('LogBok')) { New-EventLog -LogName Application -Source 'LogBok' }; Write-EventLog -LogName Application -Source 'LogBok' -EventId 9001 -EntryType Warning -Message ("LogBok agent installer/uninstaller refused on {0} by {1}: {2}" -f $env:COMPUTERNAME, $me.Name, $_.Exception.Message) } catch { }
}
try { Set-Content -Path (Join-Path $env:SystemRoot 'Temp\logbok-agent-install.log') -Value ($script:lines -join "`r`n") -Encoding UTF8 } catch { }
if ($Unattended) {
    if ($ok) { return ('OK | ' + ($script:lines -join ' | ')) }
    throw ($script:lines -join ' | ')
}
if ($ok) { Start-Sleep -Seconds 6 } else { Write-Host "`nPress any key to close." -ForegroundColor Yellow; [void]$Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown') }
'@

# فراخوانی با مسیرِ کاملِ PowerShell (نه از PATH/پوشهٔ دانلود)، بدونِ پاس‌دادنِ آرگومانِ دلخواه
# full path to PowerShell (no PATH / current-folder hijack), working dir System32, no arbitrary arguments
$script:WinCmd = "@echo off`r`nsetlocal`r`ncd /d `"%SystemRoot%\System32`"`r`n`"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe`" -NoProfile -ExecutionPolicy Bypass -File `"%~dp0Install-LogBokAgent.ps1`"`r`nendlocal`r`n"
$script:WinUnCmd = "@echo off`r`nsetlocal`r`ncd /d `"%SystemRoot%\System32`"`r`n`"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe`" -NoProfile -ExecutionPolicy Bypass -File `"%~dp0Install-LogBokAgent.ps1`" -Uninstall`r`nendlocal`r`n"

$script:WinReadme = @'
LogBok agent for Windows
========================
LogBok server: __COLLECTOR__

Install:
  1. Copy this folder to the computer.
  2. Double-click Install-LogBokAgent.cmd
     It asks for administrator rights itself, does everything and closes.
     Nothing else is needed: no user, password, share or exclusion to create by hand.
     The computer appears in the LogBok console within about 2 minutes.

Remove:
  Uninstall-LogBokAgent.cmd  (asks for this computer's uninstall code: LogBok console > Agents)

What the installer does automatically:
  - turns on Windows audit policy and the important event logs
  - installs the LogBok watchdog and login guard (Task Scheduler, SYSTEM)
  - sends new events to the LogBok server every 2 minutes (signed, TCP __INGEST_PORT__)
    and follows the server if its IP address changes
  - adds a Microsoft Defender exclusion for the agent folder (locked for normal users)
  - opens NO inbound port; every message is encrypted (AES-256) and signed (HMAC-SHA256)
  - verifies the SHA-256 and digital signature of every file before installing
  - runs at idle priority so the user never notices it
Log: C:\Windows\Temp\logbok-agent-install.log
'@

# --- اسکریپتِ لینوکس | Linux installer (POSIX sh, LF line endings) -------------------
$script:LinuxInstaller = @'
#!/bin/sh
# ==========================================================================
#  LogBok agent for Linux (generated by the LogBok server)
#  Forwards authentication logs and warnings to the LogBok server via syslog.
#  Install:   sudo sh install-logbok-agent.sh
#  Remove:    sudo sh install-logbok-agent.sh --uninstall
# ==========================================================================
COLLECTOR="__COLLECTOR__"
PORT="__PORT__"
RCONF=/etc/rsyslog.d/60-logbok.conf
NCONF=/etc/syslog-ng/conf.d/60-logbok.conf

if [ "$(id -u)" -ne 0 ]; then
  if command -v sudo >/dev/null 2>&1; then exec sudo sh "$0" "$@"; fi
  echo "Run as root."; exit 1
fi

restart_syslog() {
  for s in rsyslog syslog-ng; do
    if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files 2>/dev/null | grep -q "^$s"; then
      systemctl enable "$s" >/dev/null 2>&1; systemctl restart "$s" && return 0
    fi
    if command -v service >/dev/null 2>&1; then service "$s" restart >/dev/null 2>&1 && return 0; fi
    if command -v rc-service >/dev/null 2>&1; then rc-service "$s" restart >/dev/null 2>&1 && return 0; fi
  done
  return 1
}

if [ "$1" = "--uninstall" ]; then
  rm -f "$RCONF" "$NCONF"
  restart_syslog
  echo "LogBok agent removed."
  exit 0
fi

echo "==== LogBok agent -> $COLLECTOR:$PORT/udp ===="
if ! command -v rsyslogd >/dev/null 2>&1 && ! command -v syslog-ng >/dev/null 2>&1; then
  echo "[1/3] installing rsyslog ..."
  if   command -v apt-get >/dev/null 2>&1; then apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq rsyslog
  elif command -v dnf     >/dev/null 2>&1; then dnf install -y -q rsyslog
  elif command -v yum     >/dev/null 2>&1; then yum install -y -q rsyslog
  elif command -v zypper  >/dev/null 2>&1; then zypper -q -n install rsyslog
  elif command -v apk     >/dev/null 2>&1; then apk add -q rsyslog && rc-update add rsyslog default >/dev/null 2>&1
  else echo "ERROR: no package manager found; install rsyslog and run again."; exit 1; fi
else
  echo "[1/3] syslog daemon present"
fi

if command -v rsyslogd >/dev/null 2>&1; then
  mkdir -p /etc/rsyslog.d
  cat > "$RCONF" <<EOF
# LogBok agent (managed file) - forwards to the LogBok server
auth,authpriv.*                       @$COLLECTOR:$PORT
*.warning;auth,authpriv.none          @$COLLECTOR:$PORT
EOF
  echo "[2/3] rsyslog configured: $RCONF"
else
  SRC=$(grep -ho 'source[[:space:]]\+s_[A-Za-z0-9_]\+' /etc/syslog-ng/syslog-ng.conf 2>/dev/null | head -n1 | awk '{print $2}')
  [ -z "$SRC" ] && SRC=s_src
  mkdir -p /etc/syslog-ng/conf.d
  cat > "$NCONF" <<EOF
# LogBok agent (managed file)
destination d_logbok { network("$COLLECTOR" transport("udp") port($PORT)); };
filter f_logbok { facility(auth, authpriv) or level(warning..emerg); };
log { source($SRC); filter(f_logbok); destination(d_logbok); };
EOF
  echo "[2/3] syslog-ng configured: $NCONF (source $SRC)"
fi

if restart_syslog; then echo "[3/3] syslog service restarted"; else echo "WARNING: restart the syslog service manually"; fi
logger -p auth.notice -t logbok-agent "LogBok agent installed on $(hostname), collector $COLLECTOR"
echo "Done. Test entry sent; it appears in the LogBok console (Log search, source = syslog)."
'@

function Expand-LBAgentTemplate {
    param([string]$Text, [string]$Collector, [string[]]$Ips, [string]$Account, [int]$Port = 514, [string[]]$Names, [string]$Stamp, [string]$Key, [int]$IngestPort = 8687)
    $q = { param($a) (@($a | Where-Object { $_ }) | ForEach-Object { "'" + ($_ -replace "'", '') + "'" }) -join ',' }
    $ipList = & $q $Ips
    if (-not $ipList) { $ipList = "'" + $Collector + "'" }
    $nm = @($Names); if ($Collector -notmatch '^\d+\.\d+\.\d+\.\d+$') { $nm = @($Collector) + $nm }
    $nameList = & $q @($nm | Select-Object -Unique)
    return $Text.Replace('__ENROLL_TOKEN__', ($Key -replace "[^0-9a-f]", '')).Replace('__INGEST_PORT__', [string]$IngestPort).Replace('__COLLECTOR_IPS__', $ipList).Replace('__COLLECTOR_NAMES__', $nameList).Replace('__COLLECTOR_ACCOUNT__', ($Account -replace "'", '')).Replace('__COLLECTOR__', $Collector).Replace('__VERSION__', $script:AgentVersion).Replace('__STAMP__', ($Stamp -replace "'", '')).Replace('__BUILT__', (Get-Date).ToString('yyyy-MM-dd HH:mm', $script:Inv)).Replace('__PORT__', [string]$Port)
}

# امضای بسته: اگر نسخه، نشانیِ سرور یا کدِ ایجنت عوض شود، تغییر می‌کند | package stamp
function Get-LBAgentStamp {
    param([string]$InstallDir, $CollectorInfo, [string]$Collector, [string]$Token)
    if (-not $Token) { try { $Token = [string](Get-LBPackageEnroll -InstallDir $InstallDir).Token } catch { } }
    # هر فایلِ بسته که عوض شود، مهر عوض می‌شود → بسته بازسازی و ایجنت‌ها خودکار به‌روز می‌شوند | any payload file change -> new stamp -> rebuild -> agents self-update
    $t = 0; foreach ($fn in $script:AgentPayload) { $fi = Get-Item (Join-Path $InstallDir $fn) -ErrorAction SilentlyContinue; if ($fi -and $fi.LastWriteTimeUtc.Ticks -gt $t) { $t = $fi.LastWriteTimeUtc.Ticks } }
    $raw = "{0}|{1}|{2}|{3}|{4}|{5}" -f $script:AgentVersion, $Collector, (@($CollectorInfo.Ips) -join ','), (@($CollectorInfo.Names) -join ','), $t, $Token
    $sha = [Security.Cryptography.SHA1]::Create()
    return ($script:AgentVersion + '-' + ((($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($raw)) | Select-Object -First 6) | ForEach-Object { $_.ToString('x2') }) -join ''))
}

# پوشهٔ نصبِ ویندوز را می‌سازد (برای ZIP یا برای push) | build the Windows package folder
function New-LBAgentFolder {
    param([Parameter(Mandatory)][string]$InstallDir, [Parameter(Mandatory)][string]$OutDir, [string]$Collector, $CollectorInfo)
    if (-not $CollectorInfo) { $CollectorInfo = Get-LBCollectorInfo }
    if (-not $CollectorInfo.Names) { $CollectorInfo.Names = @() }
    if (-not $Collector) { $Collector = $CollectorInfo.Default }
    if (-not (Test-LBAgentAddress $Collector)) { throw "invalid collector address: $Collector" }
    $ips = @($CollectorInfo.Ips); if ($Collector -match '^\d+\.\d+\.\d+\.\d+$' -and $ips -notcontains $Collector) { $ips = @($Collector) + $ips }
    if (Test-Path $OutDir) { Remove-Item -Path $OutDir -Recurse -Force }
    $files = Join-Path $OutDir 'files'
    New-Item -ItemType Directory -Path $files -Force | Out-Null
    $n = 0
    foreach ($fn in $script:AgentPayload) { $s = Join-Path $InstallDir $fn; if (Test-Path $s) { Copy-Item -Path $s -Destination (Join-Path $files $fn) -Force; $n++ } }
    $bom = New-Object Text.UTF8Encoding($true)
    $cfgK = $null; try { $cfgK = Get-LogBokConfig } catch { }
    $enr = Get-LBPackageEnroll -InstallDir $InstallDir
    $key = [string]$enr.Token
    $stamp = Get-LBAgentStamp -InstallDir $InstallDir -CollectorInfo $CollectorInfo -Collector $Collector -Token $key
    $ip8 = 8687; try { if ($cfgK.Agent -and $cfgK.Agent.IngestPort) { $ip8 = [int]$cfgK.Agent.IngestPort } } catch { }
    $ps = Expand-LBAgentTemplate -Text $script:WinInstaller -Collector $Collector -Ips $ips -Account ([string]$CollectorInfo.Account) -Names @($CollectorInfo.Names) -Stamp $stamp -Key $key -IngestPort $ip8
    [IO.File]::WriteAllText((Join-Path $OutDir 'version.txt'), $stamp, [Text.Encoding]::ASCII)
    [IO.File]::WriteAllText((Join-Path $OutDir 'Install-LogBokAgent.ps1'), ($ps -replace "`r?`n", "`r`n"), $bom)
    [IO.File]::WriteAllText((Join-Path $OutDir 'Install-LogBokAgent.cmd'), $script:WinCmd, [Text.Encoding]::ASCII)
    [IO.File]::WriteAllText((Join-Path $OutDir 'Uninstall-LogBokAgent.cmd'), $script:WinUnCmd, [Text.Encoding]::ASCII)
    $rd = Expand-LBAgentTemplate -Text $script:WinReadme -Collector $Collector -Ips $ips -Account '' -IngestPort $ip8
    [IO.File]::WriteAllText((Join-Path $OutDir 'README.txt'), ($rd -replace "`r?`n", "`r`n"), $bom)
    # امضای Authenticode (گواهیِ امضای کدِ سازمان، وگرنه گواهیِ خودامضای همین سرور) | Authenticode signing
    $cert = Get-LBCodeSigningCert
    if ($cert) { foreach ($f in (Get-ChildItem -Path $OutDir -Recurse -Include *.ps1, *.psm1 -File)) { try { [void](Set-AuthenticodeSignature -FilePath $f.FullName -Certificate $cert -HashAlgorithm SHA256 -ErrorAction Stop) } catch { } } }
    # فهرستِ SHA-256 همهٔ فایل‌ها؛ نصب‌کننده هر تغییری را رد می‌کند | manifest of SHA-256 hashes
    $sha = [Security.Cryptography.SHA256]::Create(); $mf = [ordered]@{}
    foreach ($f in (Get-ChildItem -Path $OutDir -Recurse -File | Sort-Object FullName)) { $rel = $f.FullName.Substring($OutDir.TrimEnd('\','/').Length + 1) -replace '\\', '/'; $mf[$rel] = -join ($sha.ComputeHash([IO.File]::ReadAllBytes($f.FullName)) | ForEach-Object { $_.ToString('x2') }) }
    [IO.File]::WriteAllText((Join-Path $OutDir 'manifest.json'), (ConvertTo-Json -InputObject ([ordered]@{ stamp = $stamp; built = (Get-Date).ToString('o', $script:Inv); signer = $(if ($cert) { $cert.Subject } else { '' }); thumbprint = $(if ($cert) { $cert.Thumbprint } else { '' }); files = $mf }) -Depth 4), (New-Object Text.UTF8Encoding($false)))
    return $n
}

# توکنِ ثبت‌نامِ فعلی (ساخته می‌شود اگر نباشد) | current enrollment token
function Get-LBPackageEnroll {
    param([string]$InstallDir)
    if (-not (Get-Command Get-LBEnrollInfo -ErrorAction SilentlyContinue)) { Import-Module (Join-Path $PSScriptRoot 'LogBok.AgentIn.psm1') -DisableNameChecking -Global -ErrorAction Stop }
    $cfgE = $null; try { $cfgE = Get-LogBokConfig } catch { }
    return (Get-LBEnrollInfo -StateDir (Get-LBStateDir -Config $cfgE -Root $InstallDir))
}
# گواهیِ امضای کد: اول گواهیِ معتبرِ سازمان، وگرنه یک گواهیِ خودامضای اختصاصیِ همین سرور (یک‌بار ساخته می‌شود)
# code-signing cert: an organisation cert if present, else this server's own self-signed one (created once)
function Get-LBCodeSigningCert {
    if ([Environment]::OSVersion.Platform -ne 'Win32NT') { return $null }
    try {
        $all = @(Get-ChildItem Cert:\LocalMachine\My -CodeSigningCert -ErrorAction Stop | Where-Object { $_.HasPrivateKey -and $_.NotAfter -gt (Get-Date).AddDays(7) })
        $org = $all | Where-Object { $_.Subject -notlike 'CN=LogBok Agent Signing*' -and $_.Issuer -ne $_.Subject } | Sort-Object NotAfter -Descending | Select-Object -First 1
        if ($org) { return $org }
        $own = $all | Where-Object { $_.Subject -like 'CN=LogBok Agent Signing*' } | Sort-Object NotAfter -Descending | Select-Object -First 1
        if ($own) { return $own }
        return (New-SelfSignedCertificate -Type CodeSigningCert -Subject ("CN=LogBok Agent Signing ({0})" -f $env:COMPUTERNAME) -CertStoreLocation 'Cert:\LocalMachine\My' -KeyExportPolicy NonExportable -KeyAlgorithm RSA -KeyLength 3072 -HashAlgorithm SHA256 -NotAfter (Get-Date).AddYears(5) -ErrorAction Stop)
    } catch { return $null }
}

# ZIP برای دانلود | Windows agent ZIP as bytes
function New-LBAgentZip {
    param([Parameter(Mandatory)][string]$InstallDir, [string]$Collector, [string]$OutFile)
    $tmp = Join-Path ([IO.Path]::GetTempPath()) ('lbagent-' + [guid]::NewGuid().ToString('N').Substring(0, 8))
    $dir = Join-Path $tmp 'LogBok-Agent'
    try {
        [void](New-LBAgentFolder -InstallDir $InstallDir -OutDir $dir -Collector $Collector)
        Add-Type -AssemblyName System.IO.Compression -ErrorAction SilentlyContinue
        Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction SilentlyContinue
        $zip = Join-Path $tmp 'LogBok-Agent.zip'
        [IO.Compression.ZipFile]::CreateFromDirectory($dir, $zip, [IO.Compression.CompressionLevel]::Optimal, $true)
        if ($OutFile) { Copy-Item -Path $zip -Destination $OutFile -Force }
        return [IO.File]::ReadAllBytes($zip)
    } finally { Remove-Item -Path $tmp -Recurse -Force -ErrorAction SilentlyContinue }
}

# --- نصبِ تک‌پورتی (کشش از سرور) | single-port bootstrap installer -------------------------------
#   کاربر یک خط را روی سیستمِ مقصد (با دسترسیِ مدیر) اجرا می‌کند؛ بسته فقط از پورتِ ۸۶۸۷ کشیده می‌شود.
#   the user runs one line on the target (as admin); the package is pulled over port 8687 only.
$script:Bootstrap = @'
# LogBok agent - one-line installer (verified). Run in an ELEVATED PowerShell.
# The line that fetched this script checked its SHA-256; this script checks the package's SHA-256.
$ErrorActionPreference = 'Stop'
$Server = '__SERVER__'; $Port = __PORT__; $Token = '__TOKEN__'; $PkgSha = '__PKGSHA__'
try { Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force } catch { }
$me = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
if (-not $me.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host 'LogBok: needs administrator rights. Open PowerShell with "Run as administrator" and paste the line again.' -ForegroundColor Yellow
    return
}
Write-Host 'LogBok: downloading the agent...' -ForegroundColor Cyan
$tmp = Join-Path $env:TEMP ('LogBok-Setup-' + [guid]::NewGuid().ToString('N').Substring(0,8))
New-Item -ItemType Directory -Path $tmp -Force | Out-Null
$zip = Join-Path $tmp 'agent.zip'
try { (New-Object Net.WebClient).DownloadFile(("http://{0}:{1}/pkg?t={2}" -f $Server, $Port, $Token), $zip) }
catch { Write-Host ("LogBok: could not reach the server on port {0}. Check the computer can open http://{1}:{0}/ping - {2}" -f $Port, $Server, $_.Exception.Message) -ForegroundColor Red; return }
if ($PkgSha) {
    $fs = [IO.File]::OpenRead($zip)
    try { $got = [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($fs)).Replace('-', '') } finally { $fs.Dispose() }
    if ($got -ne $PkgSha) { Remove-Item $tmp -Recurse -Force -ErrorAction SilentlyContinue; Write-Host 'LogBok: the downloaded package failed verification and was deleted. Nothing was installed.' -ForegroundColor Red; return }
}
Add-Type -AssemblyName System.IO.Compression.FileSystem
$ex = Join-Path $tmp 'x'
[IO.Compression.ZipFile]::ExtractToDirectory($zip, $ex)
$inst = Join-Path $ex 'LogBok-Agent\Install-LogBokAgent.ps1'
if (-not (Test-Path $inst)) { Write-Host 'LogBok: downloaded package looks wrong.' -ForegroundColor Red; return }
Write-Host 'LogBok: installing...' -ForegroundColor Cyan
& $inst -Unattended
try { Remove-Item $tmp -Recurse -Force -ErrorAction SilentlyContinue } catch { }
Write-Host 'LogBok: done. This computer will appear in the console within ~2 minutes.' -ForegroundColor Green
'@
# SHA-256ِ بستهٔ ایجنت (با کش) | agent package SHA-256, cached by size+mtime
$script:PkgShaCache = @{ Key = ''; Sha = '' }
function Get-LBPkgHash {
    param([string]$InstallDir)
    if (-not $InstallDir) { return '' }
    $zf = Join-Path $InstallDir '_Agents\Windows\LogBok-Agent.zip'
    if (-not (Test-Path $zf)) { $zf = Join-Path (Join-Path (Join-Path $InstallDir '_Agents') 'Windows') 'LogBok-Agent.zip' }
    if (-not (Test-Path $zf)) { return '' }
    $fi = Get-Item $zf; $k = ('{0}|{1}' -f $fi.Length, $fi.LastWriteTimeUtc.Ticks)
    if ($script:PkgShaCache.Key -eq $k) { return $script:PkgShaCache.Sha }
    $fs = [IO.File]::OpenRead($zf)
    try { $h = [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($fs)).Replace('-', '') } finally { $fs.Dispose() }
    $script:PkgShaCache = @{ Key = $k; Sha = $h }
    return $h
}
function New-LBBootstrapScript {
    param([Parameter(Mandatory)][string]$Server, [int]$Port = 8687, [Parameter(Mandatory)][string]$Token, [string]$PkgHash = '')
    $srv = ($Server -replace "[^A-Za-z0-9_.\-]", '').ToLowerInvariant(); $tok = ($Token -replace "[^0-9a-f]", ''); $sha = ($PkgHash -replace '[^0-9A-Fa-f]', '').ToUpperInvariant()
    return ($script:Bootstrap.Replace('__SERVER__', $srv).Replace('__PORT__', [string]([int]$Port)).Replace('__TOKEN__', $tok).Replace('__PKGSHA__', $sha) -replace "`r?`n", "`r`n")
}
# خطِ تأییدشده (PowerShell خالص): اسکریپت را می‌گیرد، SHA-256 را می‌سنجد، فقط اگر درست بود اجرا می‌کند
# verified one-liner (pure PowerShell): download → check SHA-256 → run only if it matches
function Get-LBBootstrapLine {
    param([string]$Server, [int]$Port = 8687, [string]$Token, [string]$InstallDir, $Config)
    if (-not $Server) { $Server = (Get-LBCollectorInfo -Config $Config).Default }
    if (-not $Token) { return '' }
    $srv = ($Server -replace "[^A-Za-z0-9_.\-]", '').ToLowerInvariant(); $tok = ($Token -replace "[^0-9a-f]", '')
    $boot = New-LBBootstrapScript -Server $srv -Port $Port -Token $tok -PkgHash (Get-LBPkgHash -InstallDir $InstallDir)
    $bh = [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes($boot))).Replace('-', '')
    return ("`$b=(New-Object Net.WebClient).DownloadData('http://{0}:{1}/install.ps1?t={2}');if([BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash(`$b)).Replace('-','') -eq '{3}'){{iex ([Text.Encoding]::UTF8.GetString(`$b))}}else{{Write-Host 'LogBok: verification failed - nothing was run. Get a fresh line from the console.' -ForegroundColor Red}}" -f $srv, [int]$Port, $tok, $bh)
}
# خطِ آماده برای کپی | the ready-to-copy one-liner (verified when the package exists)
function Get-LBBootstrapCommand {
    param([string]$Server, [int]$Port = 8687, [string]$Token, $Config, [string]$InstallDir)
    if (-not $Token) { return '' }
    if ($InstallDir -and (Get-LBPkgHash -InstallDir $InstallDir)) { return (Get-LBBootstrapLine -Server $Server -Port $Port -Token $Token -InstallDir $InstallDir -Config $Config) }
    if (-not $Server) { $Server = (Get-LBCollectorInfo -Config $Config).Default }
    $tok = ($Token -replace "[^0-9a-f]", '')
    return ('powershell -NoProfile -ExecutionPolicy Bypass -Command "iwr http://{0}:{1}/install.ps1?t={2} -UseBasicParsing | iex"' -f $Server.ToLowerInvariant(), [int]$Port, $tok)
}
# فایلِ «LogBok-Join.cmd» برای فلش/پوشهٔ اشتراکی: دوبار کلیک → خودش مدیر می‌گیرد و همان خطِ تأییدشده را اجرا می‌کند
# LogBok-Join.cmd for a USB stick: double-click → self-elevates → runs the same verified line
function Get-LBJoinCmd {
    param([string]$Line)
    if (-not $Line) { return '' }
    $l = $Line.Replace('"', '\"')
    $t = @(
        '@echo off'
        'rem LogBok - join this computer (runs the verified one-line installer once)'
        'net session >nul 2>&1'
        'if errorlevel 1 ( powershell -NoProfile -Command "Start-Process -FilePath ''%~f0'' -Verb RunAs" & exit /b )'
        ('powershell -NoProfile -ExecutionPolicy Bypass -Command "' + $l + '"')
        'timeout /t 8 >nul'
    ) -join "`r`n"
    return $t + "`r`n"
}
# نصبِ از راه دور (WinRM/SMB/WMI) پیش‌فرض خاموش است | remote push (WinRM/SMB/WMI) is OFF by default
function Test-LBRemotePushAllowed {
    param([string]$StateDir)
    try { $o = Get-LBSettingsOverlay -StateDir $StateDir; if ($o.Agent -is [hashtable] -and $o.Agent.RemotePush -eq $true) { return $true } } catch { }
    return $false
}
$script:PushOffMsg = 'نصب از راه دور (WinRM/SMB/WMI) برای امنیت خاموش است. در دامنه از «نصبِ امن روی کلِ دامنه» (GPO، بدونِ هیچ پورتِ باز) و در Workgroup از «یک خط / فایلِ نصب» استفاده کنید. | Remote push (WinRM/SMB/WMI) is off for security. In a domain use "Secure install on the whole domain" (GPO, no open port); in a workgroup use "One line / install file".'
function Assert-LBRemotePush { param([string]$StateDir) if (-not (Test-LBRemotePushAllowed -StateDir $StateDir)) { throw $script:PushOffMsg } }

# اسکریپتِ لینوکس (LF) | Linux script text
function New-LBLinuxAgentScript {
    param([string]$Collector, $Config)
    if (-not $Collector) { $Collector = (Get-LBCollectorInfo).Default }
    if (-not (Test-LBAgentAddress $Collector)) { throw "invalid collector address: $Collector" }
    $s = Expand-LBAgentTemplate -Text $script:LinuxInstaller -Collector $Collector -Ips @() -Account '' -Port (Get-LBSyslogPort -Config $Config)
    return ($s -replace "`r`n", "`n")
}

# بسته‌های آماده روی دیسک (برای کپیِ دستی) | ready-made packages under <InstallDir>\_Agents
function Update-LBAgentPackages {
    param([Parameter(Mandatory)][string]$InstallDir, $Config, [switch]$Force)
    $base = Join-Path $InstallDir '_Agents'
    $win = Join-Path $base 'Windows'; $lin = Join-Path $base 'Linux'
    foreach ($d in $base, $win, $lin) { if (-not (Test-Path $d)) { New-Item -ItemType Directory -Path $d -Force | Out-Null } }
    $ci = Get-LBCollectorInfo -Config $Config
    $stamp = Join-Path $base 'build.txt'
    $want = Get-LBAgentStamp -InstallDir $InstallDir -CollectorInfo $ci -Collector $ci.Default
    if (-not $Force -and (Test-Path $stamp) -and ((Get-Content $stamp -Raw).Trim() -eq $want) -and (Test-Path (Join-Path $win 'LogBok-Agent.zip'))) { return $false }
    [void](New-LBAgentZip -InstallDir $InstallDir -Collector $ci.Default -OutFile (Join-Path $win 'LogBok-Agent.zip'))
    $folder = Join-Path $win 'LogBok-Agent'
    [void](New-LBAgentFolder -InstallDir $InstallDir -OutDir $folder -Collector $ci.Default -CollectorInfo $ci)
    $sh = New-LBLinuxAgentScript -Collector $ci.Default -Config $Config
    [IO.File]::WriteAllText((Join-Path $lin 'install-logbok-agent.sh'), $sh, (New-Object Text.UTF8Encoding($false)))
    Set-Content -Path $stamp -Value $want -Encoding ASCII
    return $true
}

# --- وضعیتِ ایجنت‌ها | agent status store ------------------------------------------
function Get-LBAgentDir { param([string]$StateDir) $d = Join-Path $StateDir 'agents'; if (-not (Test-Path $d)) { New-Item -ItemType Directory -Path $d -Force | Out-Null }; return $d }
function Set-LBAgentStatus {
    param([Parameter(Mandatory)][string]$StateDir, [Parameter(Mandatory)][string]$Name, [hashtable]$Fields)
    if ($Name -notmatch '^[A-Za-z0-9_.\-]{1,100}$') { throw "invalid name: $Name" }
    $f = Join-Path (Get-LBAgentDir -StateDir $StateDir) ($Name + '.json')
    $cur = [ordered]@{}
    if (Test-Path $f) { try { $o = Get-Content $f -Raw -Encoding UTF8 | ConvertFrom-Json; foreach ($p in $o.PSObject.Properties) { $cur[$p.Name] = $p.Value } } catch { } }
    $cur['Name'] = $Name
    foreach ($k in $Fields.Keys) { $cur[$k] = $Fields[$k] }
    $cur['Updated'] = (Get-Date).ToString('o', $script:Inv)
    $tmp = "$f.tmp"
    [IO.File]::WriteAllText($tmp, ($cur | ConvertTo-Json -Depth 5), (New-Object Text.UTF8Encoding($false)))
    Move-Item -Path $tmp -Destination $f -Force
}
function Get-LBAgentStatus {
    param([Parameter(Mandatory)][string]$StateDir)
    $out = @()
    foreach ($f in @(Get-ChildItem -Path (Get-LBAgentDir -StateDir $StateDir) -Filter '*.json' -File -ErrorAction SilentlyContinue)) {
        try { $out += (Get-Content $f.FullName -Raw -Encoding UTF8 | ConvertFrom-Json) } catch { }
    }
    return @($out)
}
function Remove-LBAgentStatus {
    param([Parameter(Mandatory)][string]$StateDir, [Parameter(Mandatory)][string]$Name)
    if ($Name -notmatch '^[A-Za-z0-9_.\-]{1,100}$') { return }
    Remove-Item -Path (Join-Path (Get-LBAgentDir -StateDir $StateDir) ($Name + '.json')) -Force -ErrorAction SilentlyContinue
}

# --- نصبِ از راه دور (در فرایندِ جدا اجرا می‌شود) | remote push (runs in its own process)
function Start-LBAgentPush {
    param([Parameter(Mandatory)][string]$InstallDir, [Parameter(Mandatory)][string]$Name, [string]$Address, [string]$Collector, [string]$CredName, [string]$StateDir)
    if (-not $StateDir) { $StateDir = Get-LBStateDir -Config (Get-LogBokConfig) -Root $InstallDir }
    Assert-LBRemotePush -StateDir $StateDir
    $runner = Join-Path $InstallDir 'Run-AgentPush.ps1'
    if (-not (Test-Path $runner)) { throw 'Run-AgentPush.ps1 not found' }
    if ($Name -notmatch '^[A-Za-z0-9_.\-]{1,100}$') { throw "invalid name: $Name" }
    if ($Address -and -not (Test-LBAgentAddress $Address)) { throw "invalid address: $Address" }
    if ($Collector -and -not (Test-LBAgentAddress $Collector)) { throw "invalid collector: $Collector" }
    $a = "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$runner`" -Name $Name"
    if ($Address) { $a += " -Address $Address" }
    if ($Collector) { $a += " -Collector $Collector" }
    if ($CredName -and $CredName -match '^[A-Za-z0-9_.\-]{1,100}$') { $a += " -CredName $CredName" }
    Start-Process -FilePath 'powershell.exe' -ArgumentList $a -WindowStyle Hidden | Out-Null
}

